          "version": 3,
          "body": "<style>\n:root {--bg: #111111;--surface: #1a1a1a;--surface-2: #222222;--line: #2e2e2e;--line-strong: #404040;--text: #f2f2f2;--text-muted: #9a9a9a;--text-dim: #6a6a6a;--accent: #ff3d57;--accent-soft: rgba(255,61,87,0.14)}\n\n* {box-sizing: border-box}\n\nhtml, body {margin: 0;padding: 0;background: var(--bg);color: var(--text);font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif;font-size: 16px;line-height: 1.7;-webkit-font-smoothing: antialiased}\n\na {color: var(--text);text-decoration: none}\n\n/* ================= HERO ================= */\n.hero {min-height: 100vh;display: flex;flex-direction: column;justify-content: center;padding: 80px 24px 120px;position: relative;overflow: hidden;border-bottom: 1px solid var(--line)}\n\n.hero-inner {max-width: 1400px;margin: 0 auto;width: 100%}\n\n.hero-label {font-size: 12px;letter-spacing: 0.3em;color: var(--text-dim);text-transform: uppercase;margin-bottom: 40px;display: flex;align-items: center;gap: 12px}\n\n.hero-label::before {content: \"\";width: 8px;height: 8px;background: var(--accent);border-radius: 50%}\n\n.hero h1 {font-size: clamp(96px, 22vw, 320px);font-weight: 900;line-height: 0.85;letter-spacing: -0.04em;margin: 0;color: var(--text)}\n\n.hero h1 .dot {color: var(--accent)}\n\n.hero-tagline {max-width: 620px;margin-top: 48px;font-size: clamp(18px, 2.2vw, 26px);line-height: 1.5;color: var(--text-muted);font-weight: 400}\n\n.hero-tagline strong {color: var(--text);font-weight: 600}\n\n.hero-meta {position: absolute;bottom: 32px;left: 24px;right: 24px;display: flex;justify-content: space-between;align-items: flex-end;font-size: 12px;color: var(--text-dim);letter-spacing: 0.1em;flex-wrap: wrap;gap: 16px}\n\n.hero-meta span::before {content: \"—— \";color: var(--accent)}\n\n/* ================= INTRO ================= */\n.intro {padding: 120px 24px;border-bottom: 1px solid var(--line)}\n\n.intro-inner {max-width: 820px;margin: 0 auto}\n\n.section-label {font-size: 11px;letter-spacing: 0.3em;text-transform: uppercase;color: var(--accent);margin-bottom: 24px;display: block}\n\n.intro h2 {font-size: clamp(32px, 5vw, 48px);font-weight: 700;line-height: 1.15;letter-spacing: -0.02em;margin: 0 0 32px}\n\n.intro p {color: var(--text-muted);font-size: 18px;line-height: 1.85;margin: 0 0 24px}\n\n.intro p strong {color: var(--text);font-weight: 600}\n\n/* ================= PRINCIPLES ================= */\n.principles {padding: 120px 24px;border-bottom: 1px solid var(--line)}\n\n.principles-inner {max-width: 1200px;margin: 0 auto}\n\n.principles-head {display: grid;grid-template-columns: 1fr 1fr;gap: 60px;margin-bottom: 80px;align-items: end}\n\n.principles-head h2 {font-size: clamp(32px, 5vw, 48px);font-weight: 700;line-height: 1.15;letter-spacing: -0.02em;margin: 0}\n\n.principles-head p {color: var(--text-muted);font-size: 17px;line-height: 1.8;margin: 0}\n\n.principle-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));gap: 0}\n\n.principle-card {border-left: 3px solid var(--line);padding: 8px 32px 8px 28px;transition: border-color 0.2s ease}\n\n.principle-card:hover {border-left-color: var(--accent)}\n\n.principle-card.featured {border-left-color: var(--accent)}\n\n.principle-card .num {font-size: 13px;color: var(--text-dim);letter-spacing: 0.2em;margin-bottom: 16px;display: block}\n\n.principle-card h3 {font-size: 22px;font-weight: 700;margin: 0 0 16px;letter-spacing: -0.01em}\n\n.principle-card p {color: var(--text-muted);font-size: 15px;line-height: 1.75;margin: 0}\n\n/* ================= PLANS ================= */\n.plans {padding: 120px 24px;border-bottom: 1px solid var(--line);background: var(--surface)}\n\n.plans-inner {max-width: 1200px;margin: 0 auto}\n\n.plans-head {margin-bottom: 72px;max-width: 720px}\n\n.plans-head h2 {font-size: clamp(32px, 5vw, 48px);font-weight: 700;line-height: 1.15;letter-spacing: -0.02em;margin: 0 0 24px}\n\n.plans-head p {color: var(--text-muted);font-size: 17px;line-height: 1.8;margin: 0}\n\n.plan-compare {display: grid;grid-template-columns: 1fr 1fr;gap: 24px;margin-bottom: 48px}\n\n.plan-card {border: 1px solid var(--line);background: var(--bg);padding: 48px 40px;position: relative;transition: border-color 0.2s ease}\n\n.plan-card:hover {border-color: var(--line-strong)}\n\n.plan-card.recommended {border-color: var(--accent)}\n\n.plan-card.recommended::before {content: \"推荐选择\";position: absolute;top: -12px;left: 32px;background: var(--accent);color: #fff;font-size: 11px;letter-spacing: 0.2em;padding: 4px 14px;font-weight: 600}\n\n.plan-card .plan-name {font-size: 14px;letter-spacing: 0.25em;color: var(--text-dim);text-transform: uppercase;margin-bottom: 20px}\n\n.plan-card .plan-price {font-size: 48px;font-weight: 800;letter-spacing: -0.02em;line-height: 1;margin-bottom: 8px}\n\n.plan-card .plan-price .unit {font-size: 16px;font-weight: 400;color: var(--text-muted);margin-left: 4px}\n\n.plan-card .plan-annual {font-size: 14px;color: var(--accent);margin-bottom: 36px}\n\n.plan-card .plan-features {list-style: none;padding: 0;margin: 0 0 36px}\n\n.plan-card .plan-features li {padding: 14px 0;border-top: 1px solid var(--line);color: var(--text-muted);font-size: 15px;display: flex;align-items: flex-start;gap: 12px}\n\n.plan-card .plan-features li:last-child {border-bottom: 1px solid var(--line)}\n\n.plan-card .plan-features li::before {content: \"→\";color: var(--accent);flex-shrink: 0;font-weight: 600}\n\n.plan-card .plan-cta {display: inline-block;padding: 14px 28px;border: 1px solid var(--text);color: var(--text);font-size: 14px;letter-spacing: 0.15em;font-weight: 600;transition: all 0.2s ease}\n\n.plan-card .plan-cta:hover {background: var(--text);color: var(--bg)}\n\n.plan-card.recommended .plan-cta {background: var(--accent);border-color: var(--accent);color: #fff}\n\n.plan-card.recommended .plan-cta:hover {background: transparent;color: var(--accent)}\n\n.plan-aside {display: grid;grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));gap: 24px;border-top: 1px solid var(--line);padding-top: 48px}\n\n.plan-aside-item {border-left: 3px solid var(--accent);padding-left: 24px}\n\n.plan-aside-item .aside-name {font-size: 15px;font-weight: 700;margin-bottom: 6px}\n\n.plan-aside-item .aside-price {font-size: 24px;font-weight: 700;margin-bottom: 6px}\n\n.plan-aside-item .aside-annual {font-size: 13px;color: var(--text-muted);margin-bottom: 14px}\n\n.plan-aside-item .aside-desc {font-size: 14px;color: var(--text-muted);line-height: 1.7}\n\n/* ================= CLIENT ================= */\n.client {padding: 120px 24px;border-bottom: 1px solid var(--line)}\n\n.client-inner {max-width: 980px;margin: 0 auto}\n\n.client-head {margin-bottom: 56px}\n\n.client-head h2 {font-size: clamp(32px, 5vw, 48px);font-weight: 700;line-height: 1.15;letter-spacing: -0.02em;margin: 0 0 24px}\n\n.client-head p {color: var(--text-muted);font-size: 17px;line-height: 1.8;margin: 0;max-width: 620px}\n\n.client-steps {display: grid;grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));gap: 0}\n\n.client-step {border-left: 3px solid var(--line);padding: 12px 32px 12px 28px;transition: border-color 0.2s ease}\n\n.client-step:hover {border-left-color: var(--accent)}\n\n.client-step .step-num {font-size: 13px;color: var(--accent);letter-spacing: 0.2em;font-weight: 700;margin-bottom: 14px;display: block}\n\n.client-step h3 {font-size: 20px;font-weight: 700;margin: 0 0 12px;letter-spacing: -0.01em}\n\n.client-step p {color: var(--text-muted);font-size: 15px;line-height: 1.75;margin: 0}\n\n.client-note {margin-top: 56px;padding: 24px 28px;background: var(--surface);border-left: 3px solid var(--accent);color: var(--text-muted);font-size: 15px;line-height: 1.75}\n\n.client-note strong {color: var(--text)}\n\n/* ================= FAQ ================= */\n.faq {padding: 120px 24px 160px;border-bottom: 1px solid var(--line)}\n\n.faq-inner {max-width: 900px;margin: 0 auto}\n\n.faq-head {margin-bottom: 64px}\n\n.faq-head h2 {font-size: clamp(32px, 5vw, 48px);font-weight: 700;line-height: 1.15;letter-spacing: -0.02em;margin: 0 0 24px}\n\n.faq-head p {color: var(--text-muted);font-size: 17px;line-height: 1.8;margin: 0}\n\n.faq-dialog {display: flex;flex-direction: column;gap: 28px}\n\n.faq-item {display: flex;flex-direction: column;gap: 16px}\n\n.faq-question {align-self: flex-start;max-width: 78%;background: var(--surface);padding: 18px 24px;border-radius: 20px 20px 20px 4px;font-size: 16px;font-weight: 600;color: var(--text);line-height: 1.6;position: relative}\n\n.faq-question::after {content: \"问\";position: absolute;left: -36px;top: 14px;font-size: 11px;color: var(--text-dim);letter-spacing: 0.1em}\n\n.faq-answer {align-self: flex-end;max-width: 82%;background: var(--accent-soft);border: 1px solid rgba(255,61,87,0.3);padding: 18px 24px;border-radius: 20px 20px 4px 20px;font-size: 15px;color: var(--text-muted);line-height: 1.75;position: relative}\n\n.faq-answer::after {content: \"答\";position: absolute;right: -36px;top: 14px;font-size: 11px;color: var(--accent);letter-spacing: 0.1em}\n\n.faq-answer strong {color: var(--text)}\n\n/* ================= FOOTER ================= */\n.footer {padding: 80px 24px 120px;text-align: center}\n\n.footer-inner {max-width: 600px;margin: 0 auto}\n\n.footer p {color: var(--text-dim);font-size: 14px;line-height: 1.8;margin: 0}\n\n/* ================= BOTTOM NAV ================= */\n.bottom-nav {position: fixed;bottom: 0;left: 0;right: 0;background: rgba(17,17,17,0.95);backdrop-filter: blur(12px);border-top: 1px solid var(--line);padding: 14px 24px;display: flex;justify-content: center;gap: 32px;font-size: 13px;letter-spacing: 0.08em;z-index: 100;flex-wrap: wrap}\n\n.bottom-nav a {color: var(--text-muted);transition: color 0.2s ease;white-space: nowrap}\n\n.bottom-nav a:hover {color: var(--accent)}\n\n.bottom-nav .brand-mark {color: var(--text);font-weight: 700}\n\n/* ================= RESPONSIVE ================= */\n@media (max-width: 768px) {.hero { padding: 60px 20px 100px;}\n  .hero h1 { font-size: 88px;}\n  .hero-meta { font-size: 11px;}\n  .intro, .principles, .plans, .client, .faq { padding: 80px 20px;}\n  .principles-head { grid-template-columns: 1fr;gap: 32px;margin-bottom: 48px;}\n  .plan-compare { grid-template-columns: 1fr;gap: 16px;}\n  .plan-card { padding: 36px 28px;}\n  .plan-card .plan-price { font-size: 38px;}\n  .faq-question, .faq-answer { max-width: 92%;}\n  .faq-question::after, .faq-answer::after { display: none;}\n  .bottom-nav { gap: 18px;font-size: 12px;padding: 12px 16px;}\n  .client-steps { grid-template-columns: 1fr;}}\n\n@media (prefers-reduced-motion: reduce) {\n  * {transition: none !important}\n}\n</style><main>\n\n\n<section class=\"hero\" id=\"top\">\n  <div class=\"hero-inner\">\n    <div class=\"hero-label\">Moon · 订阅式网络连接</div>\n    <h1>Moon<span class=\"dot\">.</span></h1>\n    <p class=\"hero-tagline\">\n      一份按月续费的网络中转服务，像月亮一样——<strong>不抢戏，但一直在那里</strong>。你订阅，你连接，剩下的交给线路本身。\n    </p>\n  </div>\n  <div class=\"hero-meta\">\n    <span>编号 MOON-7329</span>\n    <span>订阅制 · 多端可用 · 按月结算</span>\n  </div>\n</section>\n\n\n<section class=\"intro\" id=\"about\">\n  <div class=\"intro-inner\">\n    <span class=\"section-label\">写在前面</span>\n    <h2>不卖焦虑，只提供一条可用的线路</h2>\n    <p>\n      Moon 不打算把自己描述成某种革命性的工具。它做的事情很简单：在公共网络与目标地址之间架一段中转通道，把你的请求从 A 点送到 B 点，中间尽量少出问题。\n    </p>\n    <p>\n      你会在下面看到三档套餐、几个使用步骤，以及一些常见问题的对话。它们不是营销话术，而是<strong>订阅之前你真正需要知道的事情</strong>：流量多少、几台设备、价格几何、出了问题找谁。\n    </p>\n    <p>\n      如果你已经在用类似服务，并且对当前的稳定性、价格或者售后不太满意，那么 Moon 值得花十分钟看一看。如果这是你第一次订阅，建议从基础版开始，跑两周再决定是否升级。\n    </p>\n  </div>\n</section>\n\n\n<section class=\"principles\" id=\"principles\">\n  <div class=\"principles-inner\">\n    <div class=\"principles-head\">\n      <h2>几条做事的规矩</h2>\n      <p>\n        这些不是承诺，是 Moon 在运营中实际遵循的方式。它们决定了你付费之后拿到的东西到底长什么样。\n      </p>\n    </div>\n\n    <div class=\"principle-grid\">\n      <article class=\"principle-card featured\">\n        <span class=\"num\">01 / 计费</span>\n        <h3>流量就是流量</h3>\n        <p>\n          套餐里写的 100GB、300GB、1000GB 是实际可用额度，不会因为协议类型或时段不同而折算。用完即停，不偷偷降速，也不额外扣费。\n        </p>\n      </article>\n\n      <article class=\"principle-card\">\n        <span class=\"num\">02 / 设备</span>\n        <h3>同时在线有上限</h3>\n        <p>\n          每档套餐对应明确的同时在线设备数。基础版 3 台、旗舰版 5 台、团队版 20 台。超出的连接会被排在队列里，不会让你莫名其妙掉线。\n        </p>\n      </article>\n\n      <article class=\"principle-card\">\n        <span class=\"num\">03 / 线路</span>\n        <h3>节点池分层</h3>\n        <p>\n          基础版接入普通节点池，旗舰版开放全部节点含 IPLC 专线，团队版提供专属高带宽节点。不同套餐看到的线路列表不一样，不是同一个池子的不同优先级。\n        </p>\n      </article>\n\n      <article class=\"principle-card\">\n        <span class=\"num\">04 / 售后</span>\n        <h3>工单而不是机器人</h3>\n        <p>\n          基础版工单按顺序处理，旗舰版优先响应，团队版配专属客户经理。没有 AI 客服挡在前面，第一封回复来自真人。\n        </p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"plans\" id=\"plans\">\n  <div class=\"plans-inner\">\n    <div class=\"plans-head\">\n      <span class=\"section-label\">套餐与价格</span>\n      <h2>三档选择，对照着看</h2>\n      <p>\n        下面两栏是个人用户最常比较的两档：基础版与旗舰版。团队版作为补充列在下方，适合多人共用或企业场景。年付价格已标注，按年付比月付便宜约两个月。\n      </p>\n    </div>\n\n    <div class=\"plan-compare\">\n      \n      <article class=\"plan-card\">\n        <div class=\"plan-name\">基础版</div>\n        <div class=\"plan-price\">¥15<span class=\"unit\">/月</span></div>\n        <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n        <ul class=\"plan-features\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">订阅基础版</a>\n      </article>\n\n      \n      <article class=\"plan-card recommended\">\n        <div class=\"plan-name\">旗舰版</div>\n        <div class=\"plan-price\">¥35<span class=\"unit\">/月</span></div>\n        <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n        <ul class=\"plan-features\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"plan-cta\">订阅旗舰版</a>\n      </article>\n    </div>\n\n    \n    <div class=\"plan-aside\">\n      <div class=\"plan-aside-item\">\n        <div class=\"aside-name\">团队版</div>\n        <div class=\"aside-price\">¥85/月</div>\n        <div class=\"aside-annual\">按年付仅需 ¥850/年</div>\n        <p class=\"aside-desc\">\n          每月 1000GB 流量，支持 20 台设备同时在线，VIP 专属高带宽节点，支持企业定制路由，配专属客户经理。适合小团队、工作室或多人共用的家庭账户。\n        </p>\n      </div>\n\n      <div class=\"plan-aside-item\">\n        <div class=\"aside-name\">关于续费与退款</div>\n        <div class=\"aside-price\">请在订阅前阅读</div>\n        <div class=\"aside-annual\"> </div>\n        <p class=\"aside-desc\">\n          月付套餐到期后自动暂停，不会自动扣款；年付套餐到期前 7 天会通过注册邮箱提醒。因服务性质，已使用流量的套餐不支持退款，未激活的订阅可联系工单处理。\n        </p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"client\" id=\"guide\">\n  <div class=\"client-inner\">\n    <div class=\"client-head\">\n      <span class=\"section-label\">使用指南</span>\n      <h2>从订阅到连接，四个步骤</h2>\n      <p>\n        Moon 不提供独立客户端应用程序。订阅后你会拿到一串订阅链接，将它导入你已经在用的通用客户端即可。整个过程不需要安装额外软件。\n      </p>\n    </div>\n\n    <div class=\"client-steps\">\n      <article class=\"client-step\">\n        <span class=\"step-num\">步骤 01</span>\n        <h3>选择套餐并完成订阅</h3>\n        <p>\n          在套餐页选择基础版、旗舰版或团队版，完成支付后系统会向你的注册邮箱发送一封包含订阅链接的确认邮件。\n        </p>\n      </article>\n\n      <article class=\"client-step\">\n        <span class=\"step-num\">步骤 02</span>\n        <h3>复制专属订阅链接</h3>\n        <p>\n          邮件中的链接是一串以 https 开头的地址，它对应你的账户凭证。不要公开分享这条链接，它等同于你的账户密码。\n        </p>\n      </article>\n\n      <article class=\"client-step\">\n        <span class=\"step-num\">步骤 03</span>\n        <h3>导入通用客户端</h3>\n        <p>\n          打开你设备上已安装的通用客户端，找到\"导入订阅\"或\"添加订阅地址\"选项，粘贴链接并更新。客户端会自动拉取节点列表。\n        </p>\n      </article>\n\n      <article class=\"client-step\">\n        <span class=\"step-num\">步骤 04</span>\n        <h3>选择节点并连接</h3>\n        <p>\n          从列表中选择一个延迟较低的节点，点击连接。连接成功后设备的大部分网络请求会经过 Moon 的中转线路。\n        </p>\n      </article>\n    </div>\n\n    <div class=\"client-note\">\n      <strong>关于客户端下载：</strong>Moon 本身不提供客户端程序，也不附带你可在应用商店搜索到的官方 App。请使用设备系统已有的通用客户端，或自行从可信渠道获取。具体支持的协议格式以订阅邮件中的说明为准。\n    </div>\n  </div>\n</section>\n\n\n<section class=\"faq\" id=\"faq\">\n  <div class=\"faq-inner\">\n    <div class=\"faq-head\">\n      <span class=\"section-label\">常见问题</span>\n      <h2>订阅之前通常会问的几件事</h2>\n      <p>\n        以下问题来自实际收到的工单。如果你有其他疑问，页面底部的导航可以回到顶部找到订阅入口，订阅后可通过工单系统获得真人回复。\n      </p>\n    </div>\n\n    <div class=\"faq-dialog\">\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">基础版和旗舰版的节点池到底有什么区别？是同一批节点限制速度，还是真的不同线路？</div>\n        <div class=\"faq-answer\">\n          是<strong>不同的线路列表</strong>。基础版接入的是普通节点池，这些节点带宽共享、价格较低；旗舰版开放的是包含 IPLC 专线在内的全部节点，列表里会多出一批标有\"专线\"标记的线路，走的是不同物理路径。不是同一批节点限速的区别。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">流量用完了会怎样？是直接断开还是会扣费？</div>\n        <div class=\"faq-answer\">\n          流量用完后连接会自动暂停，<strong>不会额外扣费</strong>，也不会偷偷降速继续跑。你可以选择等待下月重置，或在账户面板手动购买流量加包。加包价格以账户面板实时显示为准。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">我没有自己的客户端，Moon 会提供一个吗？</div>\n        <div class=\"faq-answer\">\n          Moon 不提供独立客户端应用程序。订阅邮件里会写明当前订阅支持的协议格式，你可以根据格式在设备上选择对应的通用客户端。如果你不确定选哪个，可以提工单，客服会根据你的设备系统给一两个常见选项的名字，但<strong>不会提供下载链接</strong>。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">同时在线设备数超了会怎样？比如旗舰版 5 台，我用第 6 台登录会挤掉前面的吗？</div>\n        <div class=\"faq-answer\">\n          第 6 台设备会进入等待状态，<strong>不会挤掉已连接的设备</strong>。系统按连接顺序排队，前面有设备断开后，排队设备自动接入。如果你经常需要超过 5 台同时在线，建议升级到团队版。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">年付和月付的套餐内容一样吗？只是价格不同？</div>\n        <div class=\"faq-answer\">\n          是的，<strong>套餐内容完全一致</strong>，区别只在结算周期。年付相当于付 10 个月用 12 个月，比月付便宜约两个月。不支持年付中途降级退款，但可以升级到更高档，补差价即可。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">流媒体解锁是什么意思？旗舰版说的\"原生解锁\"和基础版的\"基础解锁\"有什么不同？</div>\n        <div class=\"faq-answer\">\n          基础版可以访问部分流媒体服务的国际版本，但某些平台可能会识别出代理 IP 并限制内容；旗舰版的节点 IP 经过筛选，被识别为<strong>住宅或原生 IP</strong>，访问主流流媒体时不会触发代理提示。如果你的主要用途是看流媒体，建议直接选旗舰版。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">团队版的\"企业定制路由\"是什么？小团队用得上吗？</div>\n        <div class=\"faq-answer\">\n          团队版支持在账户面板里按目标域名或 IP 段指定走特定节点，比如让访问某 SaaS 服务的请求固定走某条线路。对于<strong>有固定访问目标的小团队</strong>（比如远程办公连特定机房）比较有用；如果只是几个人分别上网，基础版或旗舰版就够了。\n        </div>\n      </div>\n\n      <div class=\"faq-item\">\n        <div class=\"faq-question\">工单多久能回复？基础版和旗舰版差别大吗？</div>\n        <div class=\"faq-answer\">\n          基础版工单按提交顺序处理，通常在 <strong>12 至 24 小时</strong>内回复；旗舰版标记为优先，通常在 <strong>2 至 6 小时</strong>内回复；团队版由专属客户经理跟进，工作时间内在 <strong>1 小时</strong>左右响应。所有回复都是真人，不是自动应答。\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"footer\">\n  <div class=\"footer-inner\">\n    <p>\n      Moon 是一项按月订阅的网络中转服务。本页面内容构成订阅前的全部公开说明，不另行提供试用。<br>\n      订阅即视为你已阅读并理解本页所述的流量、设备、线路与售后规则。\n    </p>\n  </div>\n</footer>\n\n\n<nav class=\"bottom-nav\">\n  <a href=\"#top\" class=\"brand-mark\">Moon</a>\n  <a href=\"#about\">关于</a>\n  <a href=\"#principles\">规则</a>\n  <a href=\"#plans\">套餐</a>\n  <a href=\"#guide\">使用</a>\n  <a href=\"#faq\">FAQ</a>\n</nav>\n\n</main>",
